# API Configuration
PROJECT_NAME="Ad-Tech Billboard Platform"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
DEBUG=True

# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adtech
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}"

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=user@gmail.com
SMTP_PASSWORD=password
EMAILS_FROM_EMAIL=noreply@adtech.com

# File Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=5242880 # 5MB

# Initial Admin Data
FIRST_SUPERUSER=admin@adtech.com
FIRST_SUPERUSER_PASSWORD=admin123456
